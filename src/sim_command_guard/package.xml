<?xml version="1.0"?>
<package format="3">
  <name>sim_command_guard</name>
  <version>0.1.0</version>
  <description>Physics-clock command watchdog for the Gazebo Sim drive input.</description>
  <maintainer email="j.j.p.leliveld@student.tue.nl">joostleliveld</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>ignition-gazebo6</depend>
  <depend>ignition-msgs8</depend>
  <depend>ignition-transport11</depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
