<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="external_camera_b">
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>
    <link name="link">
      <sensor name="camera" type="camera">
        <camera>
          <horizontal_fov>1.5708</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>5</update_rate>
        <visualize>false</visualize>
        <topic>external_camera_b/image_raw</topic>
      </sensor>
    </link>
  </model>
</sdf>
