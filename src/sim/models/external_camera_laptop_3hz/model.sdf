<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="external_camera_laptop_3hz">
    <static>true</static>
    <!--
      Camera pose is defined per-world via <include><pose> in the world SDF.
      Intrinsics are kept consistent via world_profiles.yaml and the camera model.
    -->
    <pose>0 0 0 0 0 0</pose>
    <link name="link">
      <sensor name="camera" type="camera">
        <camera>
          <horizontal_fov>1.5708</horizontal_fov> <!-- 90 degrees -->
          <!-- Laptop commissioning profile: maintain 16:9 FOV but render one
               quarter as many pixels as the 1280x720 paper world. This is a
               separate asset and requires its own detector/projection gates. -->
          <image>
            <width>640</width>
            <height>360</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <!-- The laptop successor is deliberately paced at the required 3 Hz
             output target. It is a distinct diagnostic asset, not a change to
             the 5 Hz paper-world sensor contract. -->
        <update_rate>3</update_rate>
        <visualize>false</visualize>
        <topic>external_camera/image_raw</topic>
      </sensor>
      <!-- Depth camera (RGB-D stand-in) at the SAME pose/intrinsics as the RGB
           camera. Used to sense a viewpoint-limited height map for the occlusion
           prior (occluded backs return nothing) instead of reading exact CAD. -->
      <sensor name="depth_camera" type="depth_camera">
        <camera>
          <horizontal_fov>1.5708</horizontal_fov>
          <image><width>640</width><height>360</height><format>R_FLOAT32</format></image>
          <clip><near>0.1</near><far>100</far></clip>
        </camera>
        <always_on>0</always_on>
        <update_rate>5</update_rate>
        <visualize>false</visualize>
        <topic>external_camera/depth</topic>
      </sensor>
      <!-- Segmentation camera: update_rate reduced from 30→1 Hz.
          The semantic render pass is expensive and remains dataset-only.
           Gazebo real-time bottleneck.  YOLO detects the robot from the plain
           RGB image; these topics are never consumed at runtime.
           Keeping the sensor at 1 Hz avoids breaking any debug tooling. -->
      <sensor name="segmentation_camera" type="segmentation">
        <camera>
          <segmentation_type>semantic</segmentation_type>
          <horizontal_fov>1.5708</horizontal_fov>
          <image>
            <width>640</width>
            <height>360</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>0</always_on>
        <update_rate>1</update_rate>
        <visualize>false</visualize>
        <topic>external_camera/segmentation</topic>
      </sensor>
    </link>
  </model>
</sdf>
