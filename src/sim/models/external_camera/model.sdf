<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="external_camera">
    <static>true</static>
    <!-- 
      Camera pose is defined per-world via <include><pose> in the world SDF.
      Intrinsics are kept consistent via world_profiles.yaml and the camera model.
    -->
    <pose>0 0 0 0 0 0</pose>
    <link name="link">
      <sensor name="camera" type="camera">
        <camera>
          <horizontal_fov>1.5708</horizontal_fov> <!-- 90 degrees -->
          <!-- 1280x720: segmentation camera (the real Gazebo bottleneck) is
               already disabled; reverting RGB to original resolution keeps
               the camera model (focal length) identical to F37, preserving
               the fast CasADi EFE compilation and the r_vis/r_miss ratio. -->
          <image>
            <width>1280</width>
            <height>720</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <!-- update_rate 5 Hz. After the detector was made single-threaded
             (inference in the image callback, no GIL contention), in-run inference
             settled at ~140ms and STALENESS dropped 0.9s -> 0.14s. The effective
             camera->belief UPDATE rate is ~2.2 Hz and is bound UPSTREAM of the
             detector: Gazebo cannot render this 1280x720 oblique camera faster
             than ~2-3 Hz on the P2000 while also doing physics + YOLO. Tested
             10 Hz here -> identical ~2.2 Hz effective (render-bound), so 10 Hz only
             wastes renders. 5 Hz gives the ~2 Hz consumer headroom with fresh
             frames. Resolution/FOV/focal length unchanged so detector accuracy +
             projection + r_vis/r_miss hold. (Previously 30 Hz flooded the bridge.) -->
        <update_rate>5</update_rate>
        <visualize>false</visualize>
        <topic>external_camera/image_raw</topic>
      </sensor>
    </link>
  </model>
</sdf>
