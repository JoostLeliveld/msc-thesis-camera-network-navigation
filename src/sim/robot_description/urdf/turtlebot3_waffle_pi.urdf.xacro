<?xml version="1.0"?>
<robot name="turtlebot3_waffle_pi" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Optional namespace for multi-robot / comparison -->
  <xacro:arg name="namespace" default=""/>
  <xacro:property name="ns" value="$(arg namespace)"/>

  <!-- Common materials -->
  <xacro:include filename="$(find sim)/robot_description/urdf/common_properties.urdf.xacro"/>

  <!-- Base -->
  <link name="${ns}base_footprint"/>

  <joint name="${ns}base_joint" type="fixed">
    <parent link="${ns}base_footprint"/>
    <child link="${ns}base_link"/>
    <origin xyz="0 0 0.010" rpy="0 0 0"/>
  </joint>

  <link name="${ns}base_link">
    <visual>
      <origin xyz="-0.064 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://sim/robot_description/meshes/turtlebot3_description/meshes/bases/waffle_pi_base.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="light_black"/>
    </visual>

    <collision>
      <origin xyz="-0.064 0 0.047"/>
      <geometry>
        <box size="0.266 0.266 0.094"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="1.3729096"/>
      <origin xyz="0 0 0"/>
      <inertia
        ixx="8.7002718e-03" ixy="-4.7576583e-05" ixz="1.1160499e-04"
        iyy="8.6195418e-03" iyz="-3.5422299e-06"
        izz="1.4612727e-02"/>
    </inertial>
  </link>

  <!-- Wheels -->
  <joint name="${ns}wheel_left_joint" type="continuous">
    <parent link="${ns}base_link"/>
    <child link="${ns}wheel_left_link"/>
    <origin xyz="0 0.144 0.023" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="${ns}wheel_left_link">
    <visual>
      <origin rpy="1.57 0 0"/>
      <geometry>
        <mesh filename="package://sim/robot_description/meshes/turtlebot3_description/meshes/wheels/left_tire.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <geometry>
        <cylinder length="0.018" radius="0.033"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.02849894"/>
      <inertia
        ixx="1.1175580e-05" ixy="-4.2369783e-11" ixz="-5.9381719e-09"
        iyy="1.1192413e-05" iyz="-1.4400107e-11"
        izz="2.0712558e-05"/>
    </inertial>
  </link>

  <joint name="${ns}wheel_right_joint" type="continuous">
    <parent link="${ns}base_link"/>
    <child link="${ns}wheel_right_link"/>
    <origin xyz="0 -0.144 0.023" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="${ns}wheel_right_link">
    <visual>
      <origin rpy="1.57 0 0"/>
      <geometry>
        <mesh filename="package://sim/robot_description/meshes/turtlebot3_description/meshes/wheels/right_tire.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <geometry>
        <cylinder length="0.018" radius="0.033"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.02849894"/>
      <inertia
        ixx="1.1175580e-05" ixy="-4.2369783e-11" ixz="-5.9381719e-09"
        iyy="1.1192413e-05" iyz="-1.4400107e-11"
        izz="2.0712558e-05"/>
    </inertial>
  </link>

  <!-- Casters -->
  <joint name="${ns}caster_back_joint" type="fixed">
    <parent link="${ns}base_link"/>
    <child link="${ns}caster_back_link"/>
    <origin xyz="-0.177 0 -0.004" rpy="-1.57 0 0"/>
  </joint>

  <link name="${ns}caster_back_link">
    <collision>
      <geometry>
        <box size="0.030 0.009 0.020"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.005"/>
      <inertia
        ixx="0.001" ixy="0.0" ixz="0.0"
        iyy="0.001" iyz="0.0"
        izz="0.001"/>
    </inertial>
  </link>

  <!-- IMU -->
  <joint name="${ns}imu_joint" type="fixed">
    <parent link="${ns}base_link"/>
    <child link="${ns}imu_link"/>
    <origin xyz="0 0 0.068"/>
  </joint>

  <link name="${ns}imu_link"/>

  <!-- LiDAR -->
  <joint name="${ns}scan_joint" type="fixed">
    <parent link="${ns}base_link"/>
    <child link="${ns}base_scan"/>
    <origin xyz="-0.064 0 0.122"/>
  </joint>

  <link name="${ns}base_scan">
    <visual>
      <geometry>
        <mesh filename="package://sim/robot_description/meshes/turtlebot3_description/meshes/sensors/lds.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <geometry>
        <cylinder length="0.0315" radius="0.055"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.114"/>
      <inertia
        ixx="0.001" ixy="0.0" ixz="0.0"
        iyy="0.001" iyz="0.0"
        izz="0.001"/>
    </inertial>
  </link>

</robot>
