<?xml version="1.0" ?>
<sdf version="1.8">
  <!-- warehouse_full_4cam: flagship AWS-mesh-styled large warehouse (~24 x 20 m)
       with FOUR wall-mounted external cameras looking perpendicular to their walls.
       Generated by scripts/geometry_visibility/make_warehouse_full.py - edit the
       generator, not this file. Collision boxes == mesh visual heights, so
       physics == CAD prisms == what the cameras see. Occluder heights are
       EVALUATION-ONLY for the visibility priors. -->
  <world name="warehouse_full_4cam">
    <physics name="default_physics" type="ode"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor><real_time_update_rate>1000</real_time_update_rate></physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system"><render_engine>ogre2</render_engine></plugin>
    <gravity>0 0 -9.81</gravity><magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field><atmosphere type="adiabatic"/>
    <scene><ambient>0.58 0.58 0.58 1</ambient><background>0.70 0.72 0.74 1</background><shadows>true</shadows></scene>

    <model name="ground_plane"><static>true</static><link name="link">
      <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>24.5 20.5</size></plane></geometry></collision>
      <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>24.5 20.5</size></plane></geometry><material><ambient>0.56 0.55 0.51 1</ambient><diffuse>0.56 0.55 0.51 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
    </link></model>

    <model name="warehouse_walls"><static>true</static>
      <link name="wall_east"><pose>12.000 0.000 2.250 0 0 0</pose><collision name="collision"><geometry><box><size>0.180 20.000 4.500</size></box></geometry></collision><sensor name="contact" type="contact"><contact><collision>collision</collision></contact><update_rate>60</update_rate></sensor><visual name="visual"><geometry><box><size>0.180 20.000 4.500</size></box></geometry><material><ambient>0.62 0.64 0.67 1</ambient><diffuse>0.62 0.64 0.67 1</diffuse></material></visual></link>
      <link name="wall_west"><pose>-12.000 0.000 2.250 0 0 0</pose><collision name="collision"><geometry><box><size>0.180 20.000 4.500</size></box></geometry></collision><sensor name="contact" type="contact"><contact><collision>collision</collision></contact><update_rate>60</update_rate></sensor><visual name="visual"><geometry><box><size>0.180 20.000 4.500</size></box></geometry><material><ambient>0.62 0.64 0.67 1</ambient><diffuse>0.62 0.64 0.67 1</diffuse></material></visual></link>
      <link name="wall_north"><pose>0.000 10.000 2.250 0 0 0</pose><collision name="collision"><geometry><box><size>24.000 0.180 4.500</size></box></geometry></collision><sensor name="contact" type="contact"><contact><collision>collision</collision></contact><update_rate>60</update_rate></sensor><visual name="visual"><geometry><box><size>24.000 0.180 4.500</size></box></geometry><material><ambient>0.62 0.64 0.67 1</ambient><diffuse>0.62 0.64 0.67 1</diffuse></material></visual></link>
      <link name="wall_south"><pose>0.000 -10.000 2.250 0 0 0</pose><collision name="collision"><geometry><box><size>24.000 0.180 4.500</size></box></geometry></collision><sensor name="contact" type="contact"><contact><collision>collision</collision></contact><update_rate>60</update_rate></sensor><visual name="visual"><geometry><box><size>24.000 0.180 4.500</size></box></geometry><material><ambient>0.62 0.64 0.67 1</ambient><diffuse>0.62 0.64 0.67 1</diffuse></material></visual></link>
      <link name="south_dock_a"><pose>-7.500 -9.920 0.075 0 0 0</pose><visual name="visual"><geometry><box><size>1.100 0.070 0.150</size></box></geometry><material><ambient>0.50 0.50 0.50 1</ambient><diffuse>0.50 0.50 0.50 1</diffuse></material></visual></link>
      <link name="south_dock_b"><pose>-2.500 -9.920 0.075 0 0 0</pose><visual name="visual"><geometry><box><size>1.100 0.070 0.150</size></box></geometry><material><ambient>0.50 0.50 0.50 1</ambient><diffuse>0.50 0.50 0.50 1</diffuse></material></visual></link>
      <link name="south_dock_c"><pose>2.500 -9.920 0.075 0 0 0</pose><visual name="visual"><geometry><box><size>1.100 0.070 0.150</size></box></geometry><material><ambient>0.50 0.50 0.50 1</ambient><diffuse>0.50 0.50 0.50 1</diffuse></material></visual></link>
      <link name="south_dock_d"><pose>7.500 -9.920 0.075 0 0 0</pose><visual name="visual"><geometry><box><size>1.100 0.070 0.150</size></box></geometry><material><ambient>0.50 0.50 0.50 1</ambient><diffuse>0.50 0.50 0.50 1</diffuse></material></visual></link>
      <link name="north_dock_a"><pose>-5.000 9.920 0.075 0 0 0</pose><visual name="visual"><geometry><box><size>1.100 0.070 0.150</size></box></geometry><material><ambient>0.50 0.50 0.50 1</ambient><diffuse>0.50 0.50 0.50 1</diffuse></material></visual></link>
      <link name="north_dock_b"><pose>5.000 9.920 0.075 0 0 0</pose><visual name="visual"><geometry><box><size>1.100 0.070 0.150</size></box></geometry><material><ambient>0.50 0.50 0.50 1</ambient><diffuse>0.50 0.50 0.50 1</diffuse></material></visual></link>
    </model>

