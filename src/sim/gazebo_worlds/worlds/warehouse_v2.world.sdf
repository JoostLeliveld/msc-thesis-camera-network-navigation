<?xml version="1.0" ?>
<sdf version="1.8">
  <!-- warehouse_v2: three storage sections (north-south racking, racking turned
       90 degrees, and floor block stacks) around a dock apron and a central
       artery.  Stock state A.
       This file IS the world: every reference image was rendered in it (shadows
       off, RGB camera sensors only). Edit this file directly. world/warehouse_v2.py
       describes its zones and cameras for planning and figures, and a test checks
       that every collision box lies inside a declared zone.
       Contact sensors were removed on 2026-09-24: collisions are scored offline as
       the robot footprint leaving the driveable region. Nothing that renders
       differs from the capture world (sha256 25fc40d3eb57...). -->
  <world name="warehouse_v2">
    <physics name="default_physics" type="ode"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor><real_time_update_rate>1000</real_time_update_rate></physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system"><render_engine>ogre2</render_engine></plugin>
    <gravity>0 0 -9.81</gravity><magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field><atmosphere type="adiabatic"/>
    <scene><ambient>0.20 0.20 0.21 1</ambient><background>0.74 0.78 0.82 1</background><shadows>false</shadows></scene>

    <!-- One directional light so the racking has form instead of reading as flat
         clay, plus hung fixtures over the aisles.  Lamp_01's geometry sits at
         z in [12.50, 14.02] inside its own DAE, so the include pose has to be
         NEGATIVE to hang it in this building: -5.30 puts the fixture at 7.20 m. -->
    <light type="directional" name="sun">
      <pose>0 0 12 0 0 0</pose><cast_shadows>false</cast_shadows>
      <diffuse>0.42 0.41 0.40 1</diffuse><specular>0.12 0.12 0.12 1</specular>
      <direction>-0.35 0.55 -0.80</direction>
      <attenuation><range>60</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
    </light>
    <include><name>lamp_0</name><uri>model://aws_robomaker_warehouse_Lamp_01</uri><pose>-7.05 -2.40 -5.50 0 0 0</pose></include>
    <model name="lamp_glow_0"><static>true</static><pose>-7.05 -2.40 6.97 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>1.20 0.22 0.03</size></box></geometry><material><ambient>1 0.98 0.92 1</ambient><diffuse>1 0.98 0.92 1</diffuse><specular>0.2 0.2 0.2 1</specular><emissive>1 0.97 0.90 1</emissive></material><cast_shadows>false</cast_shadows></visual></link></model>
    <light type="point" name="lamp_light_0"><pose>-7.05 -2.40 6.95 0 0 0</pose><cast_shadows>false</cast_shadows><diffuse>0.600 0.586 0.545 1</diffuse><specular>0.05 0.05 0.05 1</specular><attenuation><range>12.0</range><constant>1.00</constant><linear>0.035</linear><quadratic>0.0060</quadratic></attenuation></light>
