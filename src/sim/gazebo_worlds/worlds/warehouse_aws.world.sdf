      <link name="shelf_box_R1_upper_1"><pose>-4.050 3.080 1.30 0 0 0</pose><visual name="visual"><geometry><box><size>0.390 0.27 0.16</size></box></geometry><material><ambient>0.75 0.56 0.24 1</ambient><diffuse>0.75 0.56 0.24 1</diffuse></material></visual></link>
