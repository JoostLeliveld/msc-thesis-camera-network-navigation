      <!-- R1 mid section: fills the gap between rack_R1_lower and rack_R1_upper so the left shelf is a continuous barrier. Footprint stays in the non-driveable band between west_service_lane and rack_aisle_A1. -->
      <link name="rack_R1_mid"><pose>-4.050 1.725 0.575 0 0 0</pose><collision name="collision"><geometry><box><size>0.550 0.950 1.15</size></box></geometry></collision><sensor name="contact" type="contact"><contact><collision>collision</collision></contact><update_rate>60</update_rate></sensor><visual name="visual"><geometry><box><size>0.550 0.950 1.15</size></box></geometry><material><ambient>0.93 0.80 0.08 1</ambient><diffuse>0.93 0.80 0.08 1</diffuse></material></visual></link>
