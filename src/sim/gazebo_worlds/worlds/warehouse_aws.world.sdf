      <link name="rail_R1_upper_east"><pose>-3.775 3.225 1.22 0 0 0</pose><visual name="visual"><geometry><box><size>0.040 2.050 0.10</size></box></geometry><material><ambient>0.00 0.28 0.50 1</ambient><diffuse>0.00 0.28 0.50 1</diffuse></material></visual></link>
